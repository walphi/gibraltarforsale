---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumb from '../../components/astro/Breadcrumb.astro';
import CtaBanner from '../../components/astro/CtaBanner.astro';

export async function getStaticPaths() {
  const entries = await getCollection('market');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const publicOrigin = import.meta.env.PUBLIC_SITE_URL?.trim().replace(/\/$/, '');
const canonical = publicOrigin ? new URL(`/market/${entry.id}/`, publicOrigin).href : undefined;
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: entry.data.title,
  description: entry.data.description, dateModified: entry.data.updated,
  ...(canonical ? { mainEntityOfPage: canonical } : {}),
};
---
<SiteLayout title={entry.data.title} description={entry.data.description} type="article" updatedTime={entry.data.updated} schema={articleSchema}>
  <Breadcrumb items={[{ label: 'Market', href: '/market/' }, { label: entry.data.title }]} />
  <div class="mx-auto grid max-w-[1440px] gap-10 px-5 pb-12 pt-8 sm:px-8 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16 lg:px-12 lg:pb-20">
    <article class="min-w-0">
      <div class="mb-8 border-b border-stone-200 pb-6">
        <p class="text-[10px] font-extrabold uppercase tracking-[.17em] text-sea-700">Gibraltar market data</p>
        <p class="mt-3 text-xs text-stone-600">Updated <time datetime={entry.data.updated}>{entry.data.updated}</time> · No unsupported statistics are plotted.</p>
        <p class="mt-4 rounded-xl bg-terra-600/10 p-4 text-xs leading-6 text-ink-800">No verified current market dataset has been supplied for this page. Do not treat the proposed measures below as current market findings.</p>
      </div>
      <div class="article-content"><Content /></div>
      <div class="mt-10 border-t border-stone-200 pt-8"><CtaBanner light eyebrow="Buyer resources" title="Start with the decisions you can verify." description="Read locally specific purchase and area guides while the market-data source is being established." href="/guides/" label="Browse buyer guides" /></div>
    </article>
    <aside class="lg:sticky lg:top-6 lg:self-start">
      <nav aria-label="On this page" class="rounded-2xl border border-stone-200 bg-white p-5"><h2 class="font-body text-xs font-extrabold uppercase tracking-[.14em] text-ink-900">On this page</h2><ol class="mt-4 space-y-3 text-xs leading-5 text-stone-600">{sections.map((heading) => <li><a class="hover:text-sea-700" href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
      <a href="/market/methodology/" class="mt-4 block rounded-xl border border-stone-200 bg-white p-4 text-xs font-bold leading-5 text-sea-700 underline underline-offset-4">Read the proposed tracker methodology</a>
    </aside>
  </div>
</SiteLayout>
