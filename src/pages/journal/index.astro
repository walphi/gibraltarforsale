---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumb from '../../components/astro/Breadcrumb.astro';
import JournalCard from '../../components/astro/JournalCard.astro';
import CtaBanner from '../../components/astro/CtaBanner.astro';

const allEntries = await getCollection('journal');
const featuredEntries = allEntries.filter((entry) => entry.data.featured).sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime());
const regularEntries = allEntries.filter((entry) => !entry.data.featured).sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime());
const categories = [
  { slug: 'market-insights', label: 'Market Insights', count: allEntries.filter((e) => e.data.category === 'market-insights').length },
  { slug: 'area-spotlight', label: 'Area Spotlight', count: allEntries.filter((e) => e.data.category === 'area-spotlight').length },
  { slug: 'buyer-advice', label: 'Buyer Advice', count: allEntries.filter((e) => e.data.category === 'buyer-advice').length },
  { slug: 'legal-tax', label: 'Legal & Tax', count: allEntries.filter((e) => e.data.category === 'legal-tax').length },
  { slug: 'lifestyle', label: 'Lifestyle', count: allEntries.filter((e) => e.data.category === 'lifestyle').length },
].filter((category) => category.count > 0);
---
<SiteLayout title="Journal | Gibraltar For Sale" description="Area spotlights, buyer advice and local property context for people researching Gibraltar. General information only; market and legal claims require current source checks." image="/images/editorial/concept-planning.webp">
  <Breadcrumb items={[{ label: 'Journal' }]} />
  <section class="mx-auto max-w-[1280px] px-5 pb-20 pt-10 sm:px-8 lg:px-12 lg:pb-28 lg:pt-16">
    <p class="text-xs font-extrabold uppercase tracking-[.18em] text-sea-700">Editorial</p>
    <h1 class="mt-3 max-w-4xl font-display text-5xl font-semibold leading-tight text-ink-900 sm:text-6xl">Journal</h1>
    <p class="mt-5 max-w-3xl text-base leading-7 text-stone-600">Thoughtful local context, buyer advice and neighbourhood features for anyone researching Gibraltar property. Articles are general information, not professional advice.</p>

    {featuredEntries.length > 0 && <div class="mt-12">
      <h2 class="font-display text-3xl font-semibold text-ink-900">Featured</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {featuredEntries.map((entry) => <JournalCard slug={entry.id} title={entry.data.title} description={entry.data.description} category={entry.data.category} updated={entry.data.updated} featured={true} image={entry.data.image} imageAlt={entry.data.imageAlt} imageNote={entry.data.imageNote} />)}
      </div>
    </div>}

    <div class="mt-12 flex flex-wrap gap-2" aria-label="Filter by category">
      {categories.map((category) => <a href={`/journal/?category=${category.slug}`} class="rounded-full border border-stone-200 px-4 py-2 text-sm font-semibold text-stone-600 transition-colors hover:border-sea-700 hover:text-sea-700">{category.label} <span class="ml-1 text-xs text-stone-600">({category.count})</span></a>)}
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {regularEntries.map((entry) => <JournalCard slug={entry.id} title={entry.data.title} description={entry.data.description} category={entry.data.category} updated={entry.data.updated} image={entry.data.image} imageAlt={entry.data.imageAlt} imageNote={entry.data.imageNote} />)}
    </div>

    {allEntries.length === 0 && <div class="mt-12 rounded-2xl border border-stone-200 bg-white p-12 text-center text-stone-600">
      <p class="font-display text-2xl font-semibold text-ink-900">No articles yet</p><p class="mt-2">Journal articles will appear here once published.</p>
    </div>}

    <div class="mt-12"><CtaBanner light eyebrow="Buyer resources" title="Looking for practical guides?" description="Read the buying, costs, residency, mortgages and area resources." href="/guides/" label="Browse buyer guides" /></div>
  </section>
</SiteLayout>
