---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumb from '../../components/astro/Breadcrumb.astro';
import CtaBanner from '../../components/astro/CtaBanner.astro';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const publicOrigin = import.meta.env.PUBLIC_SITE_URL?.trim().replace(/\/$/, '');
const canonical = publicOrigin ? new URL(`/journal/${entry.id}/`, publicOrigin).href : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.updated,
  dateModified: entry.data.updated,
  author: { '@type': 'Organization', name: entry.data.author },
  publisher: { '@type': 'Organization', name: 'Gibraltar For Sale' },
  ...(canonical ? { mainEntityOfPage: canonical } : {}),
  ...(entry.data.image ? { image: entry.data.image } : {}),
  ...(entry.data.tags.length > 0 ? { keywords: entry.data.tags.join(', ') } : {}),
};

const categoryLabels: Record<string, string> = {
  'market-insights': 'Market Insights',
  'area-spotlight': 'Area Spotlight',
  'buyer-advice': 'Buyer Advice',
  'legal-tax': 'Legal & Tax',
  'lifestyle': 'Lifestyle',
};
const categoryColors: Record<string, string> = {
  'market-insights': 'text-sea-700 bg-sea-100',
  'area-spotlight': 'text-terra-600 bg-terra-100',
  'buyer-advice': 'text-emerald-700 bg-emerald-100',
  'legal-tax': 'text-amber-700 bg-amber-100',
  'lifestyle': 'text-violet-700 bg-violet-100',
};
---
<SiteLayout title={entry.data.title} description={entry.data.description} type="article" updatedTime={entry.data.updated} schema={articleSchema} image={entry.data.image}>
  <Breadcrumb items={[{ label: 'Journal', href: '/journal/' }, { label: entry.data.title }]} />
  <div class="mx-auto grid max-w-[1280px] gap-10 px-5 pb-12 pt-8 sm:px-8 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16 lg:px-12 lg:pb-20">
    <article class="min-w-0">
      <div class="mb-8 border-b border-stone-200 pb-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class={`text-[10px] font-extrabold uppercase tracking-[.17em] px-2 py-0.5 rounded-full ${categoryColors[entry.data.category]}`}>{categoryLabels[entry.data.category]}</span>
          {entry.data.featured && <span class="text-[10px] font-extrabold uppercase tracking-[.17em] text-amber-600 bg-amber-100 px-2 py-0.5 rounded-full">Featured</span>}
        </div>
        <p class="mt-3 text-xs text-stone-600">Published <time datetime={entry.data.updated}>{entry.data.updated}</time> · By {entry.data.author}</p>
        <p class="mt-4 rounded-xl bg-sea-100/70 p-4 text-xs leading-6 text-ink-800">General information only. This article is not legal, tax, immigration, mortgage, investment or financial advice. Check current official requirements and seek advice from an appropriately qualified local professional.</p>
      </div>

      {entry.data.image && (
        <figure class="mb-8 rounded-2xl overflow-hidden border border-stone-200">
          <img src={entry.data.image} alt="" class="w-full h-auto object-cover" />
        </figure>
      )}

      <div class="article-content"><Content /></div>

      {entry.data.tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2 text-xs">
          {entry.data.tags.map((tag) => <span class="px-3 py-1 text-stone-600 rounded-full border border-stone-200 bg-white">#{tag}</span>)}
        </div>
      )}

      <div class="mt-10 border-t border-stone-200 pt-8">
        <CtaBanner light eyebrow="Explore local context" title="Start with the area and the evidence." description="Read the area overviews and listing policy before comparing any particular property." href="/areas/" label="Browse area guides" />
      </div>
    </article>
    <aside class="lg:sticky lg:top-6 lg:self-start">
      <nav aria-label="On this page" class="rounded-2xl border border-stone-200 bg-white p-5 mb-4">
        <h2 class="font-body text-xs font-extrabold uppercase tracking-[.14em] text-ink-900">On this page</h2>
        <ol class="mt-4 space-y-3 text-xs leading-5 text-stone-600">{sections.map((heading) => <li><a class="hover:text-sea-700" href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </nav>
      <div class="rounded-2xl border border-stone-200 bg-white p-5">
        <h3 class="font-body text-xs font-extrabold uppercase tracking-[.14em] text-ink-900">More in Journal</h3>
        <p class="mt-3 text-xs leading-5 text-stone-600">Browse all articles for market updates, area analysis and buyer guidance.</p>
        <a href="/journal/" class="mt-3 inline-flex text-xs font-bold text-sea-700 underline underline-offset-4">View all articles →</a>
      </div>
    </aside>
  </div>
</SiteLayout>