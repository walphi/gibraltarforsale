---
import SiteLayout from '../layouts/SiteLayout.astro';
import AreaCard from '../components/astro/AreaCard.astro';
import GuideCard from '../components/astro/GuideCard.astro';
import TrustSignals from '../components/astro/TrustSignals.astro';
import EditorialImage from '../components/astro/EditorialImage.astro';
import CtaBanner from '../components/astro/CtaBanner.astro';
import { areas } from '../data/areas';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.id.localeCompare(b.id));
const featuredGuides = ['buying-property-in-gibraltar', 'gibraltar-property-taxes-and-costs', 'gibraltar-residency-and-property', 'best-areas-to-buy-property-in-gibraltar']
  .map((slug) => guides.find((guide) => guide.id === slug)).filter((guide) => guide !== undefined);
const hero = '/images/editorial/gibraltar-rock-sunset.webp';
const heroSrcSet = '/images/editorial/gibraltar-rock-sunset-900.webp 900w, /images/editorial/gibraltar-rock-sunset.webp 1600w';
---
<SiteLayout title="Gibraltar Property for Sale" description="Explore Gibraltar's neighbourhoods, practical buyer guidance and thoughtfully sourced local context. No verified properties or market feed are live yet." image={hero}>
  <section class="mx-auto grid max-w-[1280px] gap-9 px-5 pb-16 pt-10 sm:px-8 lg:grid-cols-[.95fr_1.05fr] lg:items-center lg:gap-14 lg:px-12 lg:pb-24 lg:pt-16">
    <div class="max-w-2xl">
      <p class="text-xs font-extrabold uppercase tracking-[.2em] text-sea-700">An independent Gibraltar property guide</p>
      <h1 class="mt-4 font-display text-4xl font-semibold leading-[.98] tracking-[-.035em] text-ink-900 sm:text-5xl lg:text-[4rem] xl:text-[4.5rem]">Gibraltar Property for Sale</h1>
      <p class="mt-5 max-w-xl text-[15px] leading-7 text-stone-600 sm:text-base sm:leading-8">Start with the area, understand the buying process and compare your options with clear, locally specific guidance.</p>
      <div class="mt-7 flex flex-wrap gap-2 sm:gap-3">
        <a href="/areas/" class="inline-flex min-h-12 items-center justify-center rounded-full bg-sea-700 px-4 text-sm font-extrabold text-white transition-colors hover:bg-ink-900 sm:px-6">Explore the eight areas</a>
        <a href="/guides/buying-property-in-gibraltar/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-stone-300 bg-white px-4 text-sm font-bold text-ink-900 hover:border-sea-700 hover:text-sea-700 sm:px-6">Read the buying guide</a>
      </div>
    </div>
    <div class="relative">
      <div class="overflow-hidden rounded-[2rem] border border-stone-200 bg-stone-200 shadow-[0_24px_60px_rgba(23,40,59,.13)]">
        <img src={hero} srcset={heroSrcSet} sizes="(min-width: 1024px) 52vw, 100vw" alt="The Rock of Gibraltar, harbour and coastline at sunset" width="1600" height="1200" fetchpriority="high" decoding="async" class="aspect-[1.12] w-full object-cover lg:aspect-[4/3]" />
      </div>
      <span aria-hidden="true" class="absolute -bottom-8 -left-7 -z-10 hidden h-28 w-28 rounded-full border border-sea-700/30 lg:block"></span>
    </div>
  </section>

  <section class="mx-auto max-w-[1280px] px-5 sm:px-8 lg:px-12" aria-label="Current site coverage">
    <TrustSignals />
  </section>

  <section class="mx-auto max-w-[1280px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div><p class="text-xs font-extrabold uppercase tracking-[.19em] text-sea-700">Start with place</p><h2 class="mt-3 max-w-2xl font-display text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl">Eight distinct corners of Gibraltar</h2></div>
      <a href="/areas/" class="text-sm font-bold text-sea-700 underline decoration-sea-700/30 underline-offset-4 hover:decoration-sea-700">Explore all area guides</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {areas.map((area, index) => <AreaCard {...area} index={index} />)}
    </div>
  </section>

  <section class="border-y border-stone-200 bg-white">
    <div class="mx-auto max-w-[1280px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
      <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div><p class="text-xs font-extrabold uppercase tracking-[.19em] text-sea-700">Practical, sourced guidance</p><h2 class="mt-3 max-w-2xl font-display text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl">Make the next decision with more clarity</h2></div>
        <a href="/guides/" class="text-sm font-bold text-sea-700 underline decoration-sea-700/30 underline-offset-4 hover:decoration-sea-700">All buyer guides</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {featuredGuides.map((guide) => <GuideCard slug={guide.id} title={guide.data.title} description={guide.data.description} updated={guide.data.updated} />)}
      </div>
      <div class="mt-12 grid gap-7 border-t border-stone-200 pt-10 lg:grid-cols-[.75fr_1.25fr]">
        <div><p class="text-xs font-extrabold uppercase tracking-[.17em] text-terra-600">Market data, responsibly</p><h3 class="mt-2 font-display text-3xl font-semibold text-ink-900">No numbers without a source</h3></div>
        <div><p class="max-w-3xl text-sm leading-7 text-stone-600">The tracker explains which data would be needed before a Gibraltar estimate is useful. There is no verified private-market feed or current price series available here.</p><a href="/market/property-price-tracker/" class="mt-4 inline-flex text-sm font-bold text-sea-700 underline underline-offset-4">Read the tracker status</a></div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1280px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <div class="mb-9 max-w-3xl">
      <p class="text-xs font-extrabold uppercase tracking-[.19em] text-sea-700">A considered search</p>
      <h2 class="mt-3 font-display text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl">Look beyond the viewing list.</h2>
      <p class="mt-4 text-base leading-7 text-stone-600">A calmer search begins with the routines and questions that matter to you.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      <EditorialImage image="/images/editorial/concept-terrace.webp" alt="Illustrative Mediterranean terrace concept with pale stone, greenery and soft evening light" width={1536} />
      <EditorialImage image="/images/editorial/concept-living-room.webp" alt="Illustrative contemporary living room concept in warm limestone and natural linen tones" width={1536} />
      <EditorialImage image="/images/editorial/concept-courtyard.webp" alt="Illustrative Mediterranean courtyard concept with limestone architecture and leafy planting" width={1536} />
    </div>
    <div class="mt-8 flex flex-col items-start justify-between gap-5 rounded-2xl border border-stone-200 bg-stone-100 p-6 sm:flex-row sm:items-center sm:p-8">
      <div><p class="text-xs font-bold uppercase tracking-[.15em] text-terra-600">Journal feature</p><h3 class="mt-2 font-display text-3xl font-semibold text-ink-900">A more considered way to search</h3><p class="mt-2 max-w-2xl text-sm leading-6 text-stone-600">Turn broad inspiration into a practical brief before you compare homes.</p></div>
      <a href="/journal/a-more-considered-property-search-in-gibraltar/" class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full bg-ink-900 px-5 text-sm font-bold text-white hover:bg-sea-700">Read the feature</a>
    </div>
  </section>

  <section class="mx-auto max-w-[1280px] px-5 pb-20 sm:px-8 lg:px-12 lg:pb-28">
    <CtaBanner eyebrow="The first useful step" title="Start with the questions that matter." description="Compare Gibraltar’s areas, understand the buying process and check current official sources before making a property decision." href="/guides/buying-property-in-gibraltar/" label="Read the buying guide" />
  </section>
</SiteLayout>
