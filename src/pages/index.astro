---
import SiteLayout from '../layouts/SiteLayout.astro';
import AreaCard from '../components/astro/AreaCard.astro';
import GuideCard from '../components/astro/GuideCard.astro';
import TrustSignals from '../components/astro/TrustSignals.astro';
import CtaBanner from '../components/astro/CtaBanner.astro';
import { areas } from '../data/areas';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.id.localeCompare(b.id));
const featuredGuides = ['buying-property-in-gibraltar', 'gibraltar-property-taxes-and-costs', 'gibraltar-residency-and-property', 'best-areas-to-buy-property-in-gibraltar']
  .map((slug) => guides.find((guide) => guide.id === slug)).filter((guide) => guide !== undefined);
const hero = '/manus-storage/gibraltar-hero-1600_17455c59.webp';
---
<SiteLayout title="Gibraltar Property for Sale" description="Independent area guides and practical buyer resources for people considering a move to Gibraltar. No verified property listings or market prices are live yet." image={hero}>
  <section class="mx-auto grid max-w-[1440px] gap-9 px-5 pb-16 pt-10 sm:px-8 lg:grid-cols-[.95fr_1.05fr] lg:items-center lg:gap-14 lg:px-12 lg:pb-24 lg:pt-16">
    <div class="max-w-2xl">
      <p class="text-[10px] font-extrabold uppercase tracking-[.2em] text-sea-700">An independent Gibraltar property guide</p>
      <h1 class="mt-4 font-display text-5xl font-semibold leading-[.98] text-ink-900 sm:text-6xl lg:text-7xl">Gibraltar Property for Sale</h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-stone-600 sm:text-lg sm:leading-8">Start with the area, understand the buying process, and compare your options with clear, locally specific guidance. Verified property listings are not live yet.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/areas/" class="inline-flex min-h-12 items-center justify-center rounded-full bg-sea-700 px-6 text-sm font-extrabold text-white transition-colors hover:bg-ink-900">Explore the eight areas</a>
        <a href="/guides/buying-property-in-gibraltar/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-stone-300 bg-white px-6 text-sm font-bold text-ink-900 hover:border-sea-700 hover:text-sea-700">Read the buying guide</a>
      </div>
      <div class="mt-9 max-w-xl border-l-2 border-sea-700 pl-4">
        <p class="text-sm font-semibold leading-6 text-ink-900">No real listings, agent claims or current market statistics have been supplied for this first release. We will not fill those gaps with fictional numbers.</p>
        <a href="/property-for-sale/" class="mt-2 inline-flex text-xs font-bold text-sea-700 underline underline-offset-4">Read the listing status</a>
      </div>
    </div>
    <figure class="relative">
      <div class="overflow-hidden rounded-[2rem] border border-stone-200 bg-stone-200 shadow-[0_24px_60px_rgba(23,40,59,.13)]">
        <img src={hero} srcset="/manus-storage/gibraltar-hero-900_8a1c5801.webp 900w, /manus-storage/gibraltar-hero-1600_17455c59.webp 1600w" sizes="(min-width: 1024px) 52vw, 100vw" alt="The Bay of Gibraltar and city viewed from the Rock, with the harbour and coastline beyond" width="1600" height="1067" fetchpriority="high" class="aspect-[1.12] w-full object-cover lg:aspect-[.92]" />
      </div>
      <figcaption class="mt-3 flex flex-wrap justify-between gap-2 text-[10px] text-stone-600">
        <span>Gibraltar Bay, seen from the Rock</span>
        <span>Photo by <a class="underline underline-offset-2" href="https://commons.wikimedia.org/wiki/File:Bay_of_Gibraltar_from_The_Rock_4.JPG" target="_blank" rel="noreferrer">Giorgiomonteforti</a> · public domain</span>
      </figcaption>
      <span aria-hidden="true" class="absolute -bottom-8 -left-7 -z-10 hidden h-28 w-28 rounded-full border border-sea-700/30 lg:block"></span>
    </figure>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12" aria-label="What is currently available">
    <TrustSignals />
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div><p class="text-[10px] font-extrabold uppercase tracking-[.19em] text-sea-700">Start with place</p><h2 class="mt-3 max-w-2xl font-display text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl">Eight distinct corners of Gibraltar</h2></div>
      <a href="/areas/" class="text-sm font-bold text-sea-700 underline decoration-sea-700/30 underline-offset-4 hover:decoration-sea-700">Explore all area guides</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {areas.map((area, index) => <AreaCard slug={area.slug} name={area.name} descriptor={area.descriptor} index={index} />)}
    </div>
  </section>

  <section class="border-y border-stone-200 bg-white">
    <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
      <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div><p class="text-[10px] font-extrabold uppercase tracking-[.19em] text-sea-700">Practical, sourced guidance</p><h2 class="mt-3 max-w-2xl font-display text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl">Make the next decision with more clarity</h2></div>
        <a href="/guides/" class="text-sm font-bold text-sea-700 underline decoration-sea-700/30 underline-offset-4 hover:decoration-sea-700">All buyer guides</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {featuredGuides.map((guide) => <GuideCard slug={guide.id} title={guide.data.title} description={guide.data.description} updated={guide.data.updated} />)}
      </div>
      <div class="mt-12 grid gap-7 border-t border-stone-200 pt-10 lg:grid-cols-[.75fr_1.25fr]">
        <div><p class="text-[10px] font-extrabold uppercase tracking-[.17em] text-terra-600">Market data, responsibly</p><h3 class="mt-2 font-display text-3xl font-semibold text-ink-900">No borrowed numbers</h3></div>
        <div><p class="max-w-3xl text-sm leading-7 text-stone-600">A useful price tracker needs a current, documented source and a clear sample. None has been supplied for this first release, so the tracker reports the data gap and explains how future figures should be measured—without inventing a price trend.</p><a href="/market/property-price-tracker/" class="mt-4 inline-flex text-sm font-bold text-sea-700 underline underline-offset-4">See the tracker status</a></div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <CtaBanner eyebrow="The first useful step" title="Start with the questions that matter." description="Compare Gibraltar’s areas, understand the buying process and check current official sources before making a property decision." href="/guides/buying-property-in-gibraltar/" label="Read the buying guide" />
  </section>
</SiteLayout>
