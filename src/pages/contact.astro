---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumb from '../components/astro/Breadcrumb.astro';
---
<SiteLayout title="Contact | Gibraltar For Sale" description="Contact and property-enquiry services are not active yet. Browse the current area guides, buyer resources and market-data status." noindex={false}>
  <Breadcrumb items={[{ label: 'Contact' }]} />
  <section class="mx-auto max-w-[1000px] px-5 pb-20 pt-10 sm:px-8 lg:px-12 lg:pb-28 lg:pt-16">
    <p class="text-xs font-extrabold uppercase tracking-[.18em] text-sea-700">Contact status</p>
    <h1 class="mt-3 font-display text-5xl font-semibold leading-tight text-ink-900 sm:text-6xl">Enquiries are not open yet</h1>
    <div class="mt-8 rounded-2xl border border-stone-200 bg-white p-6 sm:p-9">
      <p class="text-base leading-7 text-stone-600">There is no working contact, property-enquiry, email-alert or waitlist service at present. This page will not ask you to submit personal information to an unconfigured form.</p>
      <p class="mt-4 text-sm leading-7 text-stone-600">For now, you can read our public area guides and buyer resources. The operator's verified business contact details will be published here before any enquiry service is enabled.</p>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <a href="/guides/" class="rounded-2xl border border-stone-200 bg-white p-6 transition-colors hover:border-sea-700"><span class="text-xs font-extrabold uppercase tracking-[.15em] text-sea-700">Buyer resources</span><h2 class="mt-3 font-display text-2xl font-semibold text-ink-900">Practical guides</h2><p class="mt-2 text-sm leading-6 text-stone-600">Review the purchase process, costs, residence and other decisions.</p></a>
      <a href="/areas/" class="rounded-2xl border border-stone-200 bg-white p-6 transition-colors hover:border-sea-700"><span class="text-xs font-extrabold uppercase tracking-[.15em] text-sea-700">Local context</span><h2 class="mt-3 font-display text-2xl font-semibold text-ink-900">Explore the eight areas</h2><p class="mt-2 text-sm leading-6 text-stone-600">Read distinct neighbourhood overviews and their source notes.</p></a>
    </div>
  </section>
</SiteLayout>
