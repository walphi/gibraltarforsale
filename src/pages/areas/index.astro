---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumb from '../../components/astro/Breadcrumb.astro';
import AreaCard from '../../components/astro/AreaCard.astro';
import { areas } from '../../data/areas';

const entries = new Set((await getCollection('areas')).map((entry) => entry.id));
const cards = areas.filter((area) => entries.has(area.slug));
---
<SiteLayout title="Gibraltar Areas | Local Property Guides" description="Explore original buyer-oriented guides to Gibraltar’s South District, Ocean Village, Queensway Quay, Upper Town, Town Area, Westside, Eastside and Europa Point.">
  <Breadcrumb items={[{ label: 'Areas' }]} />
  <section class="mx-auto max-w-[1440px] px-5 pb-20 pt-10 sm:px-8 lg:px-12 lg:pb-28 lg:pt-16">
    <p class="text-[10px] font-extrabold uppercase tracking-[.18em] text-sea-700">Eight neighbourhood guides</p>
    <h1 class="mt-3 max-w-4xl font-display text-5xl font-semibold leading-tight text-ink-900 sm:text-6xl">Explore Gibraltar by area</h1>
    <p class="mt-5 max-w-3xl text-base leading-7 text-stone-600">Location affects the feel of daily life, travel, building type and the questions to ask. These guides describe local context without claiming current property prices, rental yields or home availability where a reliable dataset is not available.</p>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((area, index) => <AreaCard slug={area.slug} name={area.name} descriptor={area.descriptor} index={index} />)}
    </div>
    <div class="mt-12 rounded-2xl border border-stone-200 bg-white p-6 text-sm leading-7 text-stone-600 sm:p-8">These are research-led area overviews, not personal recommendations or valuations. No verified listings are currently live. For property-specific legal, tax, mortgage or residence questions, check the relevant authority and seek advice from a qualified local professional.</div>
  </section>
</SiteLayout>
