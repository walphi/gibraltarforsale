---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumb from '../../components/astro/Breadcrumb.astro';
import CtaBanner from '../../components/astro/CtaBanner.astro';

export async function getStaticPaths() {
  const entries = await getCollection('areas');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const publicOrigin = import.meta.env.PUBLIC_SITE_URL?.trim().replace(/\/$/, '');
const canonical = publicOrigin ? new URL(`/areas/${entry.id}/`, publicOrigin).href : undefined;
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: entry.data.title,
  description: entry.data.description, dateModified: entry.data.updated,
  ...(canonical ? { mainEntityOfPage: canonical } : {}),
};
const heroImage = entry.data.image;
---
<SiteLayout title={entry.data.title} description={entry.data.description} type="article" updatedTime={entry.data.updated} schema={articleSchema} image={heroImage}>
  <Breadcrumb items={[{ label: 'Areas', href: '/areas/' }, { label: entry.data.title }]} />
  <div class="mx-auto grid max-w-[1280px] gap-10 px-5 pb-12 pt-8 sm:px-8 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16 lg:px-12 lg:pb-20">
    <article class="min-w-0">
      {heroImage && (
        <figure class="mb-8 rounded-2xl overflow-hidden border border-stone-200">
          <img src={heroImage} alt="" class="w-full h-auto object-cover" />
        </figure>
      )}
      <div class="mb-8 border-b border-stone-200 pb-6">
        <p class="text-[10px] font-extrabold uppercase tracking-[.17em] text-sea-700">Gibraltar area guide</p>
        <p class="mt-3 text-xs text-stone-600">Updated <time datetime={entry.data.updated}>{entry.data.updated}</time></p>
        <p class="mt-2 text-xs text-stone-600">Author/reviewer: no individual professional reviewer is claimed; references are linked in the article.</p>
        <p class="mt-4 rounded-xl bg-sea-100/70 p-4 text-xs leading-6 text-ink-800">This article is general information, not a property valuation, legal, tax, residence or mortgage recommendation. Check current details with the relevant authority or a qualified local professional.</p>
      </div>
      <div class="article-content"><Content /></div>
      <div class="mt-10 border-t border-stone-200 pt-8"><CtaBanner light eyebrow="Ready to search?" title="Register for early access to listings in this area." description="Join the waitlist and we'll notify you when verified properties in this area go live." href="/contact/" label="Join the waitlist" /></div>
    </article>
    <aside class="lg:sticky lg:top-6 lg:self-start">
      <nav aria-label="On this page" class="rounded-2xl border border-stone-200 bg-white p-5">
        <h2 class="font-body text-xs font-extrabold uppercase tracking-[.14em] text-ink-900">On this page</h2>
        <ol class="mt-4 space-y-3 text-xs leading-5 text-stone-600">{sections.map((heading) => <li><a class="hover:text-sea-700" href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </nav>
      <p class="mt-4 text-xs leading-5 text-stone-600">Guide links are informational. No agent, developer or partner has been vetted or endorsed.</p>
    </aside>
  </div>
</SiteLayout>
