---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumb from '../../components/astro/Breadcrumb.astro';
import CtaBanner from '../../components/astro/CtaBanner.astro';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const publicOrigin = import.meta.env.PUBLIC_SITE_URL?.trim().replace(/\/$/, '');
const canonical = publicOrigin ? new URL(`/guides/${entry.id}/`, publicOrigin).href : undefined;
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: entry.data.title,
  description: entry.data.description, dateModified: entry.data.updated,
  ...(canonical ? { mainEntityOfPage: canonical } : {}),
};
---
<SiteLayout title={entry.data.title} description={entry.data.description} type="article" updatedTime={entry.data.updated} schema={articleSchema}>
  <Breadcrumb items={[{ label: 'Buyer guides', href: '/guides/' }, { label: entry.data.title }]} />
  <div class="mx-auto grid max-w-[1440px] gap-10 px-5 pb-12 pt-8 sm:px-8 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16 lg:px-12 lg:pb-20">
    <article class="min-w-0">
      <div class="mb-8 border-b border-stone-200 pb-6">
        <p class="text-[10px] font-extrabold uppercase tracking-[.17em] text-sea-700">Buyer guide · Gibraltar</p>
        <p class="mt-3 text-xs text-stone-600">Updated <time datetime={entry.data.updated}>{entry.data.updated}</time> · Sources appear at the end of the guide.</p>
        <p class="mt-2 text-xs text-stone-600">Author/reviewer: no individual professional reviewer is claimed; references are linked in the article.</p>
        <p class="mt-4 rounded-xl bg-sea-100/70 p-4 text-xs leading-6 text-ink-800">General information only. This guide is not legal, tax, immigration, mortgage, investment or financial advice. Check current official requirements and seek advice from an appropriately qualified local professional.</p>
      </div>
      <div class="article-content"><Content /></div>
      <div class="mt-10 border-t border-stone-200 pt-8"><CtaBanner light eyebrow="Explore local context" title="Start with the area and the evidence." description="Read the area overviews and listing policy before comparing any particular property." href="/areas/" label="Browse area guides" /></div>
    </article>
    <aside class="lg:sticky lg:top-6 lg:self-start">
      <nav aria-label="On this page" class="rounded-2xl border border-stone-200 bg-white p-5">
        <h2 class="font-body text-xs font-extrabold uppercase tracking-[.14em] text-ink-900">On this page</h2>
        <ol class="mt-4 space-y-3 text-xs leading-5 text-stone-600">{sections.map((heading) => <li><a class="hover:text-sea-700" href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </nav>
      <p class="mt-4 text-xs leading-5 text-stone-600">No individual reviewer, adviser or professional endorsement is claimed in this first release.</p>
    </aside>
  </div>
</SiteLayout>
