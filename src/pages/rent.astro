---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumb from '../components/astro/Breadcrumb.astro';
import CtaBanner from '../components/astro/CtaBanner.astro';
---
<SiteLayout title="Rent in Gibraltar" description="Find Gibraltar rentals. Register for early access to verified rental listings and be the first to know when new properties go live.">
  <Breadcrumb items={[{ label: 'Rent' }]} />
  <section class="mx-auto max-w-[1040px] px-5 pb-20 pt-10 sm:px-8 lg:px-12 lg:pb-28 lg:pt-16">
    <p class="text-[10px] font-extrabold uppercase tracking-[.18em] text-sea-700">Rentals</p>
    <h1 class="mt-3 max-w-4xl font-display text-5xl font-semibold leading-tight text-ink-900 sm:text-6xl">Renting in Gibraltar</h1>
    <div class="mt-8 rounded-2xl border border-sea-700/30 bg-sea-50 p-6 sm:p-8">
      <p class="text-[10px] font-extrabold uppercase tracking-[.16em] text-sea-700">Verified rentals coming soon</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900">Be the first to see new rental properties</h2>
      <p class="mt-4 max-w-3xl text-sm leading-7 text-stone-600">We're building a curated database of verified Gibraltar rental properties. Join the waitlist for priority access when listings go live — matched to your budget, area preferences and move-in timeline.</p>
      <form class="mt-6 max-w-md" action="/contact/" method="POST">
        <div class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-semibold text-ink-900 mb-1">Email address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm focus:border-sea-700 focus:outline-none focus:ring-2 focus:ring-sea-700/20" />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="budget" class="block text-sm font-semibold text-ink-900 mb-1">Max monthly rent (GBP)</label>
              <select id="budget" name="budget" class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm focus:border-sea-700 focus:outline-none focus:ring-2 focus:ring-sea-700/20">
                <option value="">Any</option>
                <option value="1500">£1,500</option>
                <option value="2000">£2,000</option>
                <option value="2500">£2,500</option>
                <option value="3000">£3,000</option>
                <option value="4000">£4,000+</option>
              </select>
            </div>
            <div>
              <label for="bedrooms" class="block text-sm font-semibold text-ink-900 mb-1">Min bedrooms</label>
              <select id="bedrooms" name="bedrooms" class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm focus:border-sea-700 focus:outline-none focus:ring-2 focus:ring-sea-700/20">
                <option value="">Any</option>
                <option value="0">Studio</option>
                <option value="1">1+</option>
                <option value="2">2+</option>
                <option value="3">3+</option>
              </select>
            </div>
          </div>
          <div>
            <label for="areas" class="block text-sm font-semibold text-ink-900 mb-1">Areas of interest</label>
            <select id="areas" name="areas" multiple class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm focus:border-sea-700 focus:outline-none focus:ring-2 focus:ring-sea-700/20" size="4">
              <option value="south-district">South District</option>
              <option value="ocean-village">Ocean Village</option>
              <option value="queensway-quay">Queensway Quay</option>
              <option value="upper-town">Upper Town</option>
              <option value="town-area">Town Area</option>
              <option value="westside">Westside</option>
              <option value="eastside">Eastside</option>
              <option value="europa-point">Europa Point</option>
            </select>
            <p class="mt-1 text-xs text-stone-500">Hold Ctrl/Cmd to select multiple</p>
          </div>
          <button type="submit" class="w-full inline-flex min-h-12 items-center justify-center rounded-full bg-ink-900 px-5 text-sm font-bold text-white transition-colors hover:bg-sea-700">Join the rental waitlist</button>
          <p class="text-center text-xs text-stone-500">We'll never share your email. Unsubscribe anytime.</p>
        </div>
      </form>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <a href="/guides/renting-vs-buying-in-gibraltar/" class="rounded-2xl border border-stone-200 bg-white p-6 transition-colors hover:border-sea-700"><span class="text-[10px] font-extrabold uppercase tracking-[.15em] text-sea-700">Buyer guide</span><h2 class="mt-3 font-display text-2xl font-semibold text-ink-900">Renting vs buying in Gibraltar</h2><p class="mt-2 text-sm leading-6 text-stone-600">Compare questions to weigh up before choosing a route.</p></a>
      <a href="/areas/" class="rounded-2xl border border-stone-200 bg-white p-6 transition-colors hover:border-sea-700"><span class="text-[10px] font-extrabold uppercase tracking-[.15em] text-sea-700">Local context</span><h2 class="mt-3 font-display text-2xl font-semibold text-ink-900">Explore the eight areas</h2><p class="mt-2 text-sm leading-6 text-stone-600">Read distinct local guides before comparing homes.</p></a>
    </div>
  </section>
</SiteLayout>
