---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumb from '../components/astro/Breadcrumb.astro';
---
<SiteLayout title="Rent in Gibraltar" description="Gibraltar rental listings are not live yet. Explore area guides and practical general information while verified rental data is prepared." image="/images/editorial/concept-bedroom.webp">
  <Breadcrumb items={[{ label: 'Rent' }]} />
  <section class="mx-auto max-w-[1040px] px-5 pb-20 pt-10 sm:px-8 lg:px-12 lg:pb-28 lg:pt-16">
    <p class="text-xs font-extrabold uppercase tracking-[.18em] text-sea-700">Rentals</p>
    <h1 class="mt-3 max-w-4xl font-display text-5xl font-semibold leading-tight text-ink-900 sm:text-6xl">Renting in Gibraltar</h1>
    <div class="mt-8 rounded-2xl border border-stone-200 bg-white p-6 sm:p-9">
      <p class="text-xs font-extrabold uppercase tracking-[.16em] text-terra-600">Rental search is not live</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900">No verified rentals to show yet</h2>
      <p class="mt-4 max-w-3xl text-base leading-7 text-stone-600">This page does not accept enquiries or collect contact details. We do not publish sample rentals, invented rents or unverified availability.</p>
      <figure class="mt-7 max-w-2xl overflow-hidden rounded-2xl border border-stone-200">
        <img src="/images/editorial/concept-bedroom.webp" srcset="/images/editorial/concept-bedroom-900.webp 900w, /images/editorial/concept-bedroom.webp 1536w" sizes="(max-width: 767px) 100vw, 40rem" width="1536" height="1152" loading="lazy" decoding="async" alt="Illustrative bedroom concept in warm natural tones" class="aspect-[4/3] w-full object-cover" />
      </figure>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <a href="/guides/renting-vs-buying-in-gibraltar/" class="rounded-2xl border border-stone-200 bg-white p-6 transition-colors hover:border-sea-700"><span class="text-xs font-extrabold uppercase tracking-[.15em] text-sea-700">Buyer guide</span><h2 class="mt-3 font-display text-2xl font-semibold text-ink-900">Renting vs buying in Gibraltar</h2><p class="mt-2 text-sm leading-6 text-stone-600">Compare questions to weigh up before choosing a route.</p></a>
      <a href="/areas/" class="rounded-2xl border border-stone-200 bg-white p-6 transition-colors hover:border-sea-700"><span class="text-xs font-extrabold uppercase tracking-[.15em] text-sea-700">Local context</span><h2 class="mt-3 font-display text-2xl font-semibold text-ink-900">Explore the eight areas</h2><p class="mt-2 text-sm leading-6 text-stone-600">Read distinct local guides before comparing homes.</p></a>
    </div>
  </section>
</SiteLayout>
