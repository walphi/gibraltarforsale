---
interface Props { image: string; title: string; alt: string; note: string; width?: number; position?: string }
const { image, title, alt, note, width = 1800, position = '50% 50%' } = Astro.props;
const srcSet = `${image.replace(/\.webp$/, '-900.webp')} 900w, ${image} ${width}w`;
---
<figure class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
  <img
    src={image}
    srcset={srcSet}
    sizes="(max-width: 767px) 100vw, 33vw"
    alt={alt}
    loading="lazy"
    decoding="async"
    style={`object-position: ${position}`}
    class="aspect-[4/3] w-full bg-stone-100 object-cover"
  />
  <figcaption class="p-5 sm:p-6">
    <h3 class="font-display text-2xl font-semibold leading-tight text-ink-900">{title}</h3>
    <p class="mt-2 text-xs leading-5 text-stone-600">{note}</p>
  </figcaption>
</figure>
