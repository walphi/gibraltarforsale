---
import BrandMark from './BrandMark.astro';
---
<footer class="mt-24 bg-ink-950 text-white">
  <div class="mx-auto grid max-w-[1280px] gap-12 px-5 py-14 sm:px-8 md:grid-cols-[1.3fr_1fr_1fr] lg:px-12 lg:py-20">
    <div>
      <BrandMark light />
      <p class="mt-6 max-w-sm text-sm leading-7 text-white/75">An independent guide to buying property in Gibraltar, with locally specific area information and practical buyer resources.</p>
      <p class="mt-4 max-w-sm text-xs leading-5 text-white/65">No verified property listings or enquiry service are live yet.</p>
    </div>
    <div>
      <h2 class="font-body text-xs font-bold uppercase tracking-[0.18em] text-white/70">Explore</h2>
      <ul class="mt-5 space-y-3 text-sm text-white/85">
        <li><a class="hover:text-white" href="/property-for-sale/">Property for sale</a></li>
        <li><a class="hover:text-white" href="/rent/">Rent</a></li>
        <li><a class="hover:text-white" href="/areas/">Eight area guides</a></li>
        <li><a class="hover:text-white" href="/guides/">Buyer guides</a></li>
        <li><a class="hover:text-white" href="/journal/">Journal</a></li>
        <li><a class="hover:text-white" href="/market/property-price-tracker/">Property price tracker</a></li>
        <li><a class="hover:text-white" href="/market/methodology/">Market-data methodology</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-body text-xs font-bold uppercase tracking-[0.18em] text-white/70">The details</h2>
      <ul class="mt-5 space-y-3 text-sm text-white/85">
        <li><a class="hover:text-white" href="/about/">About this guide</a></li>
        <li><a class="hover:text-white" href="/contact/">Contact status</a></li>
        <li><a class="hover:text-white" href="/privacy/">Privacy notice</a></li>
        <li><a class="hover:text-white" href="/terms/">Terms</a></li>
        <li><a class="hover:text-white" href="/cookies/">Cookie notice</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-2 px-5 py-5 text-xs text-white/70 sm:px-8 md:flex-row md:items-center md:justify-between lg:px-12">
      <span>© {new Date().getFullYear()} Gibraltar For Sale</span>
      <span>Independent property guidance for Gibraltar buyers.</span>
    </div>
  </div>
</footer>
