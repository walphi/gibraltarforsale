---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: 'market-insights' | 'area-spotlight' | 'buyer-advice' | 'legal-tax' | 'lifestyle';
  updated: string;
  featured?: boolean;
  image?: string;
  imageAlt?: string;
  imageNote?: string;
}
const { slug, title, description, category, updated, featured = false, image, imageAlt, imageNote } = Astro.props;
const categoryLabels: Record<string, string> = {
  'market-insights': 'Market Insights', 'area-spotlight': 'Area Spotlight', 'buyer-advice': 'Buyer Advice', 'legal-tax': 'Legal & Tax', 'lifestyle': 'Lifestyle',
};
const categoryColors: Record<string, string> = {
  'market-insights': 'text-sea-700 bg-sea-100', 'area-spotlight': 'text-terra-600 bg-terra-100', 'buyer-advice': 'text-emerald-700 bg-emerald-100', 'legal-tax': 'text-amber-700 bg-amber-100', 'lifestyle': 'text-violet-700 bg-violet-100',
};
const cardAlt = imageAlt || `${title} — editorial image`;
const srcSet = image ? `${image.replace(/\.webp$/, '-900.webp')} 900w, ${image} 1800w` : undefined;
---
<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white transition-transform hover:-translate-y-0.5 hover:border-sea-700/50">
  {image && <figure>
    <img src={image} srcset={srcSet} sizes="(max-width: 639px) 100vw, (max-width: 1279px) 50vw, 33vw" alt={cardAlt} loading="lazy" decoding="async" class="aspect-[16/10] w-full bg-stone-100 object-cover" />
    {imageNote && <figcaption class="bg-stone-50 px-4 py-2 text-xs leading-5 text-stone-600">{imageNote}</figcaption>}
  </figure>}
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-center gap-2">
      <span class={`rounded-full px-2 py-1 text-xs font-extrabold uppercase tracking-[.12em] ${categoryColors[category]}`}>{categoryLabels[category]}</span>
      {featured && <span class="rounded-full bg-amber-100 px-2 py-1 text-xs font-extrabold uppercase tracking-[.12em] text-amber-800">Featured</span>}
    </div>
    <h2 class="mt-4 font-display text-2xl font-semibold leading-tight text-ink-900 group-hover:text-sea-700"><a href={`/journal/${slug}/`} class="focus-visible:outline-offset-4">{title}</a></h2>
    <p class="mt-3 flex-1 text-sm leading-6 text-stone-600">{description}</p>
    <div class="mt-6 flex items-center justify-between gap-3 border-t border-stone-100 pt-4 text-sm text-stone-600">
      <time datetime={updated}>{updated}</time>
      <a href={`/journal/${slug}/`} class="font-bold text-ink-900 hover:text-sea-700">Read article <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
