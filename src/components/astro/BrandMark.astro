---
interface Props {
  compact?: boolean;
  light?: boolean;
}
const { compact = false, light = false } = Astro.props;
const textClass = light ? 'text-white' : 'text-ink-900';
---
<a href="/" class={`inline-flex items-center gap-3 no-underline ${textClass}`} aria-label="Gibraltar For Sale home">
  <svg aria-hidden="true" viewBox="0 0 44 44" class="h-10 w-10 shrink-0" fill="none">
    <rect x="1" y="1" width="42" height="42" rx="21" stroke={light ? '#A7D6DE' : '#1F748A'} stroke-width="1.3" />
    <path d="M8 29.5c5.4-3.3 8-8.2 12.5-15.8 2.1 5 3.6 8 6 10.2 2.2-2.6 4.4-3.9 9.5-4.4" stroke={light ? '#A7D6DE' : '#1F748A'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M10 33.5h24" stroke={light ? '#A7D6DE' : '#1F748A'} stroke-width="1.2" stroke-linecap="round" />
  </svg>
  {!compact && <span class="flex flex-col leading-none">
    <span class="font-body text-[0.62rem] font-bold uppercase tracking-[0.19em]">Gibraltar</span>
    <span class="mt-1 font-display text-[1.25rem] font-semibold tracking-[0.01em]">For Sale</span>
  </span>}
</a>
