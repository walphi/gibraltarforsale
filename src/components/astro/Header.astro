---
import BrandMark from './BrandMark.astro';
const nav = [
  { href: '/property-for-sale/', label: 'Property for sale' },
  { href: '/rent/', label: 'Rent' },
  { href: '/areas/', label: 'Explore areas' },
  { href: '/guides/', label: 'Buyer guides' },
  { href: '/market/', label: 'Market' },
  { href: '/journal/', label: 'Journal' },
];
const currentPath = Astro.url.pathname;
---
<header class="relative z-40 border-b border-stone-200 bg-stone-50/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-5 py-4 sm:px-8 lg:px-12">
    <BrandMark />
    <nav aria-label="Main navigation" class="hidden items-center gap-7 lg:flex">
      {nav.map((item) => <a href={item.href} aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined} class="text-sm font-semibold text-ink-800 transition-colors hover:text-sea-700">{item.label}</a>)}
    </nav>
    <div class="hidden items-center gap-3 lg:flex">
      <a href="/contact/" class="text-sm font-semibold text-ink-800 transition-colors hover:text-sea-700">Contact</a>
      <a href="/property-for-sale/" class="inline-flex min-h-11 items-center justify-center rounded-full bg-ink-900 px-5 text-sm font-bold text-white transition-colors hover:bg-sea-700">See listing status</a>
    </div>
    <details class="relative lg:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border border-stone-300 px-4 text-sm font-bold text-ink-900 focus-visible:outline-offset-2">
        Menu <span aria-hidden="true" class="text-sea-700">☰</span>
      </summary>
      <nav aria-label="Mobile navigation" class="absolute right-0 top-14 z-50 w-[min(84vw,340px)] rounded-2xl border border-stone-200 bg-white p-4 shadow-xl">
        <ul class="space-y-1">
          {nav.map((item) => <li><a href={item.href} aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined} class="block min-h-11 rounded-xl px-3 py-3 text-sm font-semibold text-ink-900 hover:bg-sea-100">{item.label}</a></li>)}
          <li><a href="/contact/" class="block min-h-11 rounded-xl px-3 py-3 text-sm font-semibold text-ink-900 hover:bg-sea-100">Contact</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
