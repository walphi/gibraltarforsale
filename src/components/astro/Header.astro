---
import BrandMark from './BrandMark.astro';
const nav = [
  { href: '/property-for-sale/', label: 'Property for sale' },
  { href: '/rent/', label: 'Rent' },
  { href: '/areas/', label: 'Explore areas' },
  { href: '/guides/', label: 'Buyer guides' },
  { href: '/market/', label: 'Market' },
  { href: '/journal/', label: 'Journal' },
];
const currentPath = Astro.url.pathname;
---
<header class="relative z-40 border-b border-stone-200 bg-stone-50/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-5 py-4 sm:px-8 lg:px-12">
    <BrandMark />
    <nav aria-label="Main navigation" class="hidden items-center gap-7 lg:flex">
      {nav.map((item) => <a href={item.href} aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined} class="text-sm font-semibold text-ink-800 transition-colors hover:text-sea-700">{item.label}</a>)}
    </nav>
    <div class="hidden items-center gap-3 lg:flex">
      <a href="/contact/" class="text-sm font-semibold text-ink-800 transition-colors hover:text-sea-700">Contact</a>
      <a href="/contact/" class="inline-flex min-h-11 items-center justify-center rounded-full bg-ink-900 px-5 text-sm font-bold text-white transition-colors hover:bg-sea-700">Join waitlist</a>
    </div>
    <button
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="lg:hidden flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-stone-300 px-4 text-sm font-bold text-ink-900 focus-visible:outline-offset-2"
      data-mobile-menu-toggle
    >
      <span aria-hidden="true" class="text-sea-700">☰</span>
      <span class="sr-only">Menu</span>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile navigation" class="lg:hidden fixed inset-0 z-50 hidden" data-mobile-menu-panel>
    <div class="absolute inset-0 bg-black/50" data-mobile-menu-overlay></div>
    <div class="absolute right-0 top-0 h-full w-[min(88vw,360px)] bg-white shadow-xl flex flex-col" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title">
      <div class="flex items-center justify-between p-4 border-b border-stone-200">
        <h2 id="mobile-menu-title" class="font-body text-sm font-bold text-ink-900">Menu</h2>
        <button
          type="button"
          aria-label="Close navigation menu"
          class="text-ink-500 hover:text-ink-900 text-xl leading-none p-1"
          data-mobile-menu-close
        >
          ×
        </button>
      </div>
      <ul class="flex-1 overflow-y-auto p-4 space-y-1">
        {nav.map((item) => <li><a href={item.href} aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined} class="block min-h-12 rounded-xl px-3 py-3 text-sm font-semibold text-ink-900 hover:bg-sea-100">{item.label}</a></li>)}
        <li><a href="/contact/" class="block min-h-12 rounded-xl px-3 py-3 text-sm font-semibold text-ink-900 hover:bg-sea-100">Contact & early access</a></li>
      </ul>
      <div class="p-4 border-t border-stone-200">
        <a href="/contact/" class="block w-full text-center min-h-12 rounded-full bg-ink-900 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-sea-700">Join waitlist</a>
      </div>
    </div>
  </nav>

  <script is:inline>
    function initMobileMenu() {
      const toggle = document.querySelector('[data-mobile-menu-toggle]');
      const panel = document.querySelector('[data-mobile-menu-panel]');
      const overlay = document.querySelector('[data-mobile-menu-overlay]');
      const closeBtn = document.querySelector('[data-mobile-menu-close]');

      if (!toggle || !panel || !overlay || !closeBtn) {
        console.warn('Mobile menu elements not found');
        return;
      }

      function openMenu() {
        panel.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        toggle.setAttribute('aria-expanded', 'true');
      }

      function closeMenu() {
        panel.classList.add('hidden');
        document.body.style.overflow = '';
        toggle.setAttribute('aria-expanded', 'false');
      }

      toggle.addEventListener('click', openMenu);
      closeBtn.addEventListener('click', closeMenu);
      overlay.addEventListener('click', closeMenu);

      // Close on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
          closeMenu();
        }
      });

      // Close on link click
      panel.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', closeMenu);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileMenu);
    } else {
      initMobileMenu();
    }
  </script>
</header>
